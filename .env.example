# Instagram Graph API (Business / Creator account)
# Option A: Instagram Login token → graph.instagram.com
# Option B: Facebook User/Page token with Page linked to IG Business → graph.facebook.com
# Do NOT prefix with VITE_ — that would expose the token in the browser bundle.
INSTAGRAM_ACCESS_TOKEN=

# Optional: Instagram Business Account ID (only needed if auto-discovery fails)
# INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Vercel (production):
# Project Settings → Environment Variables → add INSTAGRAM_ACCESS_TOKEN
# (and INSTAGRAM_BUSINESS_ACCOUNT_ID if you use it), then Redeploy.

# --- Ad landing (/hay-allergy) click tracking ---
# Meta Pixel ID from Events Manager (required to optimize Instagram ads on Spotify clicks).
# In Ads Manager, create a conversion on custom event "SpotifyListen" or standard "Lead".
VITE_META_PIXEL_ID=

# Optional Google Analytics 4 Measurement ID (G-XXXXXXXX)
VITE_GA_MEASUREMENT_ID=
