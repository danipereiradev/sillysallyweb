# Instagram Graph API (Business / Creator account)
# Option A: Instagram Login token → graph.instagram.com
# Option B: Facebook User/Page token with Page linked to IG Business → graph.facebook.com
# Do NOT prefix with VITE_ — that would expose the token in the browser bundle.
INSTAGRAM_ACCESS_TOKEN=

# Optional: Instagram Business Account ID (only needed if auto-discovery fails)
# INSTAGRAM_BUSINESS_ACCOUNT_ID=
